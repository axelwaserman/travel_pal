# SeaweedFS S3 credentials (set via `weed shell` after first run)
SEAWEEDFS_ACCESS_KEY=admin
SEAWEEDFS_SECRET_KEY=admin

# OpenSky Network OAuth2 client_credentials (https://opensky-network.org)
# Create an API client at: https://opensky-network.org/my-opensky/account
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=

# BTS On-Time Performance fixture-mode bypass.
# Set to skip the live transtats.bts.gov download and use the committed test
# fixture instead (Phase 1 cancellation rate). Path is relative to the Dagster
# container's mounted /opt/dagster/app.
# Comment out to hit BTS for real.
BTS_FIXTURE_FILE=/opt/dagster/app/tests/fixtures/bts_kjfk_2024_01.csv.zip

# Copy to .env and fill in before running docker compose up

# ---------------------------------------------------------------------------
# One-time bucket setup (run after `docker compose up` has started all services)
# ---------------------------------------------------------------------------
# docker compose exec seaweedfs-master weed shell -master=localhost:9333
#
# Inside the weed shell, run:
#   s3.bucket.create -name raw-flights
#   s3.bucket.create -name frontend-exports
#   s3.configure -user=admin -access_key=admin -secret_key=admin -actions=Read,Write,List,Tagging,Admin -apply
#   s3.configure -user=anonymous -buckets=frontend-exports -actions=Read,List -apply
#
# Exit with Ctrl+D.
#
# Verify with:
#   AWS_ACCESS_KEY_ID=admin AWS_SECRET_ACCESS_KEY=admin \
#     aws s3 ls s3://raw-flights --endpoint-url http://localhost:8333
# Expected: empty listing, no error.
#
# Notes:
#   - SeaweedFS 3.x s3.configure requires -user=<name> (not bare -access_key/-secret_key)
#   - anonymous user (no credentials) grants public read/list on frontend-exports
#   - S3 endpoint is http://localhost:8333 (seaweedfs-s3 service, NOT seaweedfs-volume)
